#!/bin/sh
# Push the mainline branch after a merge lands on it.
#
# `make worktree-merge` fast-forwards the mainline checkout, which fires this
# hook there; the same merge also fires it inside the worktree, so linked
# worktrees are skipped (their branch is merged, not published). `git pull`
# fires it too, but leaves nothing ahead of the upstream, so it is a no-op.
#
# Enable with `git config core.hooksPath .githooks`; skip a merge with
# PCODE_NO_AUTOPUSH=1.

[ "${PCODE_NO_AUTOPUSH:-0}" = "0" ] || exit 0

# In a linked worktree the per-worktree git dir differs from the common one.
[ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ] || exit 0

git symbolic-ref --quiet HEAD >/dev/null || exit 0
upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) || exit 0
[ "$(git rev-list --count "$upstream"..HEAD)" -gt 0 ] || exit 0

# Never block on a credential prompt, and never fail the merge over a push.
if ! GIT_TERMINAL_PROMPT=0 git push --quiet; then
	echo "post-merge: push to $upstream failed; push by hand" >&2
fi
exit 0
